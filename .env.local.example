# Copy to .env.local and adjust before `npm run build`.

# WhatsApp number of the Mahakal bot (country code, no +) — used for the
# post-payment wa.me redirect back into the chat.
VITE_WA_NUMBER=918178164282

# Base URL of the bot service APIs. Leave EMPTY when:
#  - the build is embedded in the Spring Boot service (same-origin), OR
#  - deploying on Vercel — vercel.json rewrites proxy /whatsapp/bot/* to the
#    backend server-side (no CORS, no mixed-content issues).
VITE_API_BASE_URL=
